# Compiles the FSR 1 shaders with glslc and writes them as byte arrays into one header (run by CMakeLists.txt).
# Inputs: -DGLSLC=<glslc> -DSRC_DIR=<shader folder> -DOUT=<header> -DWORK=<scratch folder>
file(MAKE_DIRECTORY "${WORK}")
set(_names fsr1.vert fsr1_easu.frag fsr1_rcas.frag)
set(_syms kFsr1VertSpv kFsr1EasuSpv kFsr1RcasSpv)
set(_out "// Generated by cmake/build_fsr1_spv.cmake: do not edit.\n#pragma once\n")
list(LENGTH _names _n)
math(EXPR _last "${_n} - 1")
foreach(i RANGE ${_last})
  list(GET _names ${i} _name)
  list(GET _syms ${i} _sym)
  execute_process(COMMAND "${GLSLC}" -O --target-env=vulkan1.0 -o "${WORK}/${_name}.spv" "${SRC_DIR}/${_name}"
                  RESULT_VARIABLE _r ERROR_VARIABLE _e)
  if(NOT _r EQUAL 0)
    message(FATAL_ERROR "glslc failed on ${_name}:\n${_e}")
  endif()
  file(READ "${WORK}/${_name}.spv" _hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  string(APPEND _out "alignas(4) static const unsigned char ${_sym}[] = {${_bytes}};\n")
endforeach()
file(WRITE "${OUT}" "${_out}")
